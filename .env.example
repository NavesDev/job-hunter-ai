# Credentials and secrets. Copy to .env and fill in real values.
# .env is never committed.

# SMTP (email applications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

