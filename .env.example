# Credenciais/segredos. Copie para .env e preencha com valores reais.
# .env nunca é versionado.

# SMTP (aplicação via email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

