# Credentials and secrets. Copy to .env and fill in real values.
# .env is never committed.

# SMTP (email applications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Per-platform credentials, prefixed by source name. Used only by `login`, which types
# them into the platform's own form and never prints, logs or records them.
# GeekHunter: applying signed in delivers the application right away; applying anonymously
# leaves it waiting for a link the platform emails you.
GEEKHUNTER_USERNAME=
GEEKHUNTER_PASSWORD=

# LINKEDIN_USERNAME=
# LINKEDIN_PASSWORD=
